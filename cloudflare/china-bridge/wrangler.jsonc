{
  "$schema": "../subscription-hub/node_modules/wrangler/config-schema.json",
  "name": "sub-cn-bridge",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-03",
  "vars": {
    "PUBLIC_HOST": "sub.qor.com.cn"
  },
  "services": [
    {
      "binding": "SUB",
      "service": "sub"
    }
  ]
}
