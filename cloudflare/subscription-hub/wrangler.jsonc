{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "RULE_MANIFEST_URL": "https://raw.githubusercontent.com/fengsx/Shadowrocket-Rules/refs/heads/main/dist/rules-manifest.json"
  },
  "triggers": { "crons": ["23 */6 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fengsx-sub",
      "database_id": "7f8532ec-f5b1-424f-a4c6-1c3151b5ad88"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ARTIFACTS",
      "id": "657c51fdb2064aefac77ee4485b74964"
    }
  ]
}
